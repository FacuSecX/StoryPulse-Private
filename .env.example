# ==========================================
# StoryPulse Private v2.0 - Configuración
# ==========================================

# Token del bot de Telegram generado por BotFather
TELEGRAM_BOT_TOKEN=

# ID de Telegram autorizado para utilizar el bot
TELEGRAM_CHAT_ID=

# Archivo de la sesión principal (compatibilidad con instalaciones existentes)
INSTAGRAM_STORAGE_STATE=instagram_state.json

# Configuración de sesiones habilitadas y sus archivos independientes
# El formato JSON conserva version=1; es distinto de la versión del proyecto.
INSTAGRAM_SESSIONS_CONFIG=sesiones_instagram.json

# Estado y asociaciones de acceso; se genera durante el uso
INSTAGRAM_SESSIONS_REGISTRY=estado_sesiones_instagram.json

# Directorio raíz de almacenamiento
HISTORYS_DIR=/historys

# URL opcional del panel / File Manager
STORYPULSE_PANEL_URL=

# Zona horaria
STORYPULSE_TIMEZONE=America/Argentina/Buenos_Aires
