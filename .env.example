# ==========================================
# StoryPulse Private - Configuración
# ==========================================

# Token del bot de Telegram generado por BotFather
TELEGRAM_BOT_TOKEN=

# ID de Telegram autorizado para utilizar el bot
TELEGRAM_CHAT_ID=

# Archivo de sesión web de Instagram
INSTAGRAM_STORAGE_STATE=instagram_state.json

# Directorio raíz de almacenamiento
HISTORYS_DIR=/historys

# URL opcional del panel / File Manager
STORYPULSE_PANEL_URL=

# Zona horaria
STORYPULSE_TIMEZONE=America/Argentina/Buenos_Aires